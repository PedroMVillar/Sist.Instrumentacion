{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configurar",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "Debug"],
            "options": { "cwd": "${workspaceFolder}/firmware" },
            "problemMatcher": []
        },
        {
            "label": "Compilar",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build/Debug"],
            "options": { "cwd": "${workspaceFolder}/firmware" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Grabar en la placa",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32f4x.cfg",
                "-c", "program build/Debug/firmware.elf verify reset exit"
            ],
            "options": { "cwd": "${workspaceFolder}/firmware" },
            "dependsOn": "Compilar",
            "problemMatcher": []
        },
        {
            "label": "Consola",
            "type": "shell",
            "command": "python",
            "args": ["consola/consola.py", "${input:puertoCOM}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "puertoCOM",
            "type": "promptString",
            "description": "Puerto COM del ST-LINK (mirar en Administrador de dispositivos)",
            "default": "COM5"
        }
    ]
}
