{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug en la placa (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "build/Debug/firmware.elf",
            "servertype": "openocd",
            "device": "STM32F411RE",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main"
        }
    ]
}
